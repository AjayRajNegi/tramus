{
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.8"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "name": "tramus",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "format:all": "biome check --write --unsafe --no-errors-on-unmatched",
    "lint": "turbo run lint --"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
